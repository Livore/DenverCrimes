GEMINI_API_KEY=your_gemini_api_key_here

# Firebase: scarica il JSON da Firebase Console > Impostazioni progetto > Account di servizio > Genera nuova chiave privata
# Poi metti il file nella cartella backend/ e imposta il percorso:
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Oppure incolla il contenuto del JSON come stringa (utile per deploy su Render/Railway):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
